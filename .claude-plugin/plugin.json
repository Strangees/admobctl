{
  "name": "admobctl",
  "version": "0.5.1",
  "description": "Query Google AdMob from Claude: apps, ad units, network/mediation reports, monthly finance (estimates) and monetization insights. Unofficial, not affiliated with Google.",
  "author": { "name": "Stian Strange" },
  "homepage": "https://github.com/Strangees/admobctl",
  "repository": "https://github.com/Strangees/admobctl",
  "license": "MIT",
  "keywords": ["admob", "ads", "monetization", "mcp", "finance", "reports"],
  "icon": "./assets/icon.png",
  "documentationUrl": "https://github.com/Strangees/admobctl#readme",
  "supportUrl": "https://github.com/Strangees/admobctl/issues",
  "privacyPolicyUrl": "https://github.com/Strangees/admobctl/blob/main/PRIVACY.md",
  "mcpServers": {
    "admobctl": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/admobctl.mjs", "mcp"]
    }
  }
}
