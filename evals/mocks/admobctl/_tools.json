            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "totals": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "truncated": {
            "type": "boolean"
          },
          "notice": {
            "type": "string"
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "from",
          "to",
          "rows",
          "truncated",
          "notices"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
