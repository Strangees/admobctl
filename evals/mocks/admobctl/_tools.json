    {
      "name": "admobctl_finance_month",
      "title": "AdMob earnings for a month",
      "description": "Estimated AdMob earnings for one calendar month, per app and in total, for bookkeeping. With include_journal, also returns Bilagsjournal rows (debit receivable, credit revenue per app, dated at month-end) and journal_tsv, a paste-ready tab-separated block to show verbatim. Figures are estimates, not finalized payments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "YYYY-MM"
          },
          "include_journal": {
            "description": "Also return journal rows",
            "type": "boolean"
          },
          "account": {
            "description": "Publisher ID (pub-…). Defaults to the configured or only account.",
            "type": "string"
          }
        },
        "required": [
          "month"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "estimate": {
            "type": "boolean",
            "const": true
          },
          "total": {
            "type": "number"
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "journal": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "journal_tsv": {
            "type": "string"
          }
        },
        "required": [
          "month",
          "currency",
          "complete",
          "estimate",
          "total",
          "apps",
          "notes"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
