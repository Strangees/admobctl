    {
      "name": "admobctl_network_report",
      "title": "AdMob network report",
      "description": "AdMob Network report: estimated earnings, requests, match rate, impressions, show rate, CTR and RPM by any dimension (app, ad-unit, country, format, platform, date, month…).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Start date, YYYY-MM (whole month) or YYYY-MM-DD"
          },
          "to": {
            "description": "End date, YYYY-MM or YYYY-MM-DD. Defaults to `from`.",
            "type": "string"
          },
          "by": {
            "description": "Dimensions, e.g. [\"app\"], [\"ad-unit\",\"country\"], [\"date\"]. Default [\"app\"].",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "description": "Metrics, e.g. [\"earnings\",\"impressions\",\"match-rate\",\"show-rate\",\"rpm\"]. Default: all common metrics.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filters": {
            "description": "Dimension filters, e.g. {\"country\":[\"NO\",\"SE\"],\"app\":[\"my-game-ios\"]}. App filters accept aliases.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "max_rows": {
            "description": "Row cap (default 200).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 5000
          },
          "currency": {
            "description": "ISO 4217 code to convert earnings into, e.g. USD. Default: the account currency.",
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "account": {
            "description": "Publisher ID (pub-…). Defaults to the configured or only account.",
            "type": "string"
          }
        },
        "required": [
          "from"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
