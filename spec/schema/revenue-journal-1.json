{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:revenue-journal:schema:1",
  "title": "Revenue Journal, version 1",
  "description": "JSON encoding of revenue-journal/1. Rules that a schema cannot express (balance, line numbering, unique voucher IDs, positive amounts, period order) are in SPEC.md section 4.",
  "type": "object",
  "required": [
    "format",
    "vouchers"
  ],
  "properties": {
    "format": {
      "const": "revenue-journal/1"
    },
    "producer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "amounts": {
      "type": "object",
      "required": [
        "encoding"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "decimal",
            "integer"
          ]
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "encoding": {
            "const": "integer"
          }
        }
      },
      "then": {
        "required": [
          "scale"
        ]
      }
    },
    "vouchers": {
      "type": "array"
    }
  },
  "if": {
    "type": "object",
    "required": [
      "amounts"
    ],
    "properties": {
      "amounts": {
        "type": "object",
        "properties": {
          "encoding": {
            "const": "integer"
          }
        }
      }
    }
  },
  "then": {
    "type": "object",
    "properties": {
      "vouchers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/voucher_integer"
        }
      }
    }
  },
  "else": {
    "type": "object",
    "properties": {
      "vouchers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/voucher_decimal"
        }
      }
    }
  },
  "$defs": {
    "amount_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$",
      "description": "Decimal encoding: non-negative decimal string with up to 4 fraction digits; RJ-POSITIVE additionally requires it to be greater than zero."
    },
    "amount_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer encoding: the value times 10^scale; RJ-POSITIVE additionally requires it to be greater than zero."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "role": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "earnings_receivable",
            "revenue",
            "bank",
            "fees",
            "withholding_tax",
            "fx_gain",
            "fx_loss",
            "estimate_adjustment"
          ]
        },
        {
          "pattern": "^x-[a-z0-9][a-z0-9_-]*$"
        }
      ]
    },
    "attachment": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        },
        "media_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "line",
        "role"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "account": {
          "type": "string"
        },
        "account_name": {
          "type": "string"
        },
        "vat_code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "foreign_currency": {
          "$ref": "#/$defs/currency"
        }
      },
      "oneOf": [
        {
          "required": [
            "debit"
          ]
        },
        {
          "required": [
            "credit"
          ]
        }
      ],
      "dependentRequired": {
        "foreign_currency": [
          "foreign_amount"
        ],
        "foreign_amount": [
          "foreign_currency"
        ]
      }
    },
    "line_decimal": {
      "allOf": [
        {
          "$ref": "#/$defs/line"
        },
        {
          "type": "object",
          "properties": {
            "debit": {
              "$ref": "#/$defs/amount_decimal"
            },
            "credit": {
              "$ref": "#/$defs/amount_decimal"
            },
            "foreign_amount": {
              "$ref": "#/$defs/amount_decimal"
            }
          }
        }
      ]
    },
    "line_integer": {
      "allOf": [
        {
          "$ref": "#/$defs/line"
        },
        {
          "type": "object",
          "properties": {
            "debit": {
              "$ref": "#/$defs/amount_integer"
            },
            "credit": {
              "$ref": "#/$defs/amount_integer"
            },
            "foreign_amount": {
              "$ref": "#/$defs/amount_integer"
            }
          }
        }
      ]
    },
    "voucher": {
      "type": "object",
      "required": [
        "voucher_id",
        "kind",
        "date",
        "period",
        "currency",
        "status",
        "source",
        "description",
        "lines"
      ],
      "properties": {
        "voucher_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "accrual",
            "settlement",
            "adjustment"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "period": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/date"
            },
            "to": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "currency": {
          "$ref": "#/$defs/currency"
        },
        "status": {
          "enum": [
            "estimate",
            "final"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "counterparty": {
          "type": "string"
        },
        "account_ref": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "lines": {
          "type": "array",
          "minItems": 2
        }
      }
    },
    "voucher_decimal": {
      "allOf": [
        {
          "$ref": "#/$defs/voucher"
        },
        {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/line_decimal"
              }
            }
          }
        }
      ]
    },
    "voucher_integer": {
      "allOf": [
        {
          "$ref": "#/$defs/voucher"
        },
        {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/line_integer"
              }
            }
          }
        }
      ]
    }
  }
}
